# .env.example - fal.ai MCP Server Configuration Template

# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ============================================================================
# Required Configuration
# ============================================================================

# Your fal.ai API Key
# Get it from: https://www.fal.ai/dashboard/keys
# Keep this secret! Never commit to git.
FAL_API_KEY=key_your_actual_key_here

# ============================================================================
# Optional Configuration
# ============================================================================

# Base URL for fal.ai API (optional, defaults to https://api.fal.ai)
# Use this to point to a different instance or proxy
# FAL_API_URL=https://api.fal.ai

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable debug mode (verbose output, extra logging)
# DEBUG=false

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Request timeout in seconds
# REQUEST_TIMEOUT=30

# Maximum retries for failed requests
# MAX_RETRIES=3

# Enable request/response logging
# LOG_REQUESTS=false

# ============================================================================
# Deployment Configuration
# ============================================================================

# Set to 'production' or 'development'
# ENVIRONMENT=development

# Port for HTTP transport (if using streamable_http)
# MCP_PORT=8000

# Worker threads for concurrent requests
# WORKER_THREADS=4

# ============================================================================
# Notes
# ============================================================================

# 1. API Key Security:
#    - Never commit .env to version control
#    - Use .gitignore: echo ".env" >> .gitignore
#    - Rotate keys periodically
#    - Use different keys for dev/prod

# 2. Loading Configuration:
#    - .env file is optional (uses defaults if not present)
#    - Environment variables override .env values
#    - export FAL_API_KEY=... sets via environment

# 3. Getting API Key:
#    - Visit https://www.fal.ai/dashboard
#    - Navigate to Settings → API Keys
#    - Copy your key (looks like: key_abc123...)
#    - Keep it private!

# 4. Testing Configuration:
#    - Run with: source .env && python3 fal_mcp.py
#    - Or set directly: export FAL_API_KEY=key_... && python3 fal_mcp.py

# 5. Docker Configuration:
#    - Build: docker build -t fal-mcp .
#    - Run: docker run -e FAL_API_KEY=key_... fal-mcp
#    - Don't put .env in image, use -e flag or secrets
